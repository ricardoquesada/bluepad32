// Bluepad32 BLE GATT Profile Definition
// Primary Service UUID: 4627C4A4-AC00-46B9-B688-AFC5C1BF7F63
// Characteristics are numbered contiguously from AC01 through AC0E.

PRIMARY_SERVICE, GAP_SERVICE
CHARACTERISTIC, GAP_DEVICE_NAME, READ | DYNAMIC,

PRIMARY_SERVICE, GATT_SERVICE
CHARACTERISTIC, GATT_DATABASE_HASH, READ,

// Bluepad32 Service
PRIMARY_SERVICE, 4627C4A4-AC00-46B9-B688-AFC5C1BF7F63

// Bluepad32 Characteristics
// AC01: Firmware version string (UTF-8, no NUL terminator)
CHARACTERISTIC, 4627C4A4-AC01-46B9-B688-AFC5C1BF7F63, READ | DYNAMIC

// AC02: Max supported concurrent controller connections (uint8_t)
CHARACTERISTIC, 4627C4A4-AC02-46B9-B688-AFC5C1BF7F63, READ | DYNAMIC

// AC03: Whether BLE controller connections are enabled (uint8_t: 0=disabled, 1=enabled)
CHARACTERISTIC, 4627C4A4-AC03-46B9-B688-AFC5C1BF7F63, READ | WRITE | DYNAMIC

// AC04: Scan / pair new controllers (uint8_t: 0=stop scanning, 1=start scanning)
CHARACTERISTIC, 4627C4A4-AC04-46B9-B688-AFC5C1BF7F63, READ | WRITE | DYNAMIC

// AC05: Connected controllers (N * 16-byte little-endian compact_device_t records;
// Read returns all slots; Notify pushes full table when MTU >= 67 or 1 slot when MTU == 23)
CHARACTERISTIC, 4627C4A4-AC05-46B9-B688-AFC5C1BF7F63, READ | NOTIFY | DYNAMIC

// AC06: Controller button mappings preset (uint8_t: 0=Xbox, 1=Nintendo Switch, 2=Custom)
CHARACTERISTIC, 4627C4A4-AC06-46B9-B688-AFC5C1BF7F63, READ | WRITE | DYNAMIC

// AC07: Whether Bluetooth MAC allowlist enforcement is enabled (uint8_t: 0=disabled, 1=enabled)
CHARACTERISTIC, 4627C4A4-AC07-46B9-B688-AFC5C1BF7F63, READ | WRITE | DYNAMIC

// AC08: Allowlist MAC addresses (K * 6-byte bd_addr_t entries; Read returns non-zero entries,
// Write atomically replaces the allowlist)
CHARACTERISTIC, 4627C4A4-AC08-46B9-B688-AFC5C1BF7F63, READ | WRITE | DYNAMIC

// AC09: Whether virtual child devices (e.g., touchpad mouse) are enabled (uint8_t: 0=disabled, 1=enabled)
CHARACTERISTIC, 4627C4A4-AC09-46B9-B688-AFC5C1BF7F63, READ | WRITE | DYNAMIC

// AC0A: Disconnect and delete the controller at slot idx (uint8_t: 0..MAX_DEVICES-1)
CHARACTERISTIC, 4627C4A4-AC0A-46B9-B688-AFC5C1BF7F63, WRITE | DYNAMIC

// AC0B: Delete all stored Bluetooth BR/EDR and BLE bond keys (uint8_t: 1=delete)
CHARACTERISTIC, 4627C4A4-AC0B-46B9-B688-AFC5C1BF7F63, WRITE | DYNAMIC

// AC0C: Reset / reboot the Bluepad32 device immediately (uint8_t: 1=reboot)
CHARACTERISTIC, 4627C4A4-AC0C-46B9-B688-AFC5C1BF7F63, WRITE | DYNAMIC

// AC0D: BLE service advertised device name (UTF-8, 1..29 bytes, no NUL terminator)
CHARACTERISTIC, 4627C4A4-AC0D-46B9-B688-AFC5C1BF7F63, READ | WRITE | DYNAMIC,

// AC0E: BLE service password authentication gate
// Read returns uint8_t: 0=open (no password), 1=password required (locked), 2=authenticated (unlocked)
// Write submits UTF-8 password (1..31 bytes) to authenticate the current BLE connection
CHARACTERISTIC, 4627C4A4-AC0E-46B9-B688-AFC5C1BF7F63, READ | WRITE | DYNAMIC,
